rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function campusMember() {
      return signedIn() && request.auth.token.email is string &&
        request.auth.token.email.matches('^[^@\\s]+@g\\.batstate-u\\.edu\\.ph$');
    }
    function ownsItem(itemId) {
      return signedIn() && get(/databases/$(database)/documents/items/$(itemId)).data.ownerId == request.auth.uid;
    }
    function ownsItemAfter(itemId) {
      return campusMember() && getAfter(/databases/$(database)/documents/items/$(itemId)).data.ownerId == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if campusMember() && request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role in ['student', 'teacher', 'staff'];
      allow delete: if false;
    }
    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if campusMember() && request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type in ['lost', 'found'] && request.resource.data.status == 'open';
      allow update: if ownsItem(itemId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.status in ['open', 'claimed', 'returned'];
      allow delete: if ownsItem(itemId);

      // Questions can be shown to claimers. Answers and contents stay private.
      match /verification/{document} {
        allow read: if campusMember();
        allow create, update: if ownsItemAfter(itemId);
        allow delete: if ownsItem(itemId);
      }
      match /private/{document} {
        allow read, delete: if ownsItem(itemId);
        allow create, update: if ownsItemAfter(itemId);
      }
    }
    match /claims/{claimId} {
      function participant() {
        return signedIn() && (resource.data.claimantId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      }
      // Permit a claimant to check the absence of their deterministic claim
      // inside a transaction; existing documents still require participation.
      allow get: if participant() || (campusMember() && !exists(/databases/$(database)/documents/claims/$(claimId)));
      allow list: if participant();
      allow create: if campusMember() &&
        request.resource.data.claimantId == request.auth.uid &&
        request.resource.data.claimantEmail == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.ownerId != request.auth.uid &&
        get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.ownerId == request.resource.data.ownerId &&
        get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.status == 'open';
      // Neither participant may replace identities, proof, or ownership.
      // Only the reporter can decide an ownership claim.
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        (request.resource.data.status == 'rejected' ||
          (get(/databases/$(database)/documents/items/$(resource.data.itemId)).data.status == 'open' &&
           getAfter(/databases/$(database)/documents/items/$(resource.data.itemId)).data.status == 'claimed'));
      allow delete: if participant();
    }
  }
}
